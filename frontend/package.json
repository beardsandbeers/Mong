  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/common": "^1.2.3",
    "lit": "^3.3.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
